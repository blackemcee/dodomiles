// learn more about the schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TripStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Trip {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  tagline         String
  status          TripStatus @default(DRAFT)

  startDate       DateTime
  endDate         DateTime

  countries       String[]
  region          String
  startCity       String
  endCity         String

  priceCents      Int
  depositCents    Int?
  currency        String     @default("EUR")
  maxParticipants Int        @default(8)

  heroImageUrl    String
  summary         String
  description     String

  hostName        String
  hostBio         String
  hostImageUrl    String

  inclusions      String[]

  days            TripDay[]
  faqItems        FaqItem[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model TripDay {
  id             String  @id @default(cuid())
  tripId         String
  trip           Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  dayNumber      Int
  title          String
  description    String
  distanceKm     Float?
  elevationGainM Int?
  elevationLossM Int?
  imageUrl       String?

  @@unique([tripId, dayNumber])
}

model FaqItem {
  id       String @id @default(cuid())
  tripId   String
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  question String
  answer   String
  order    Int

  @@unique([tripId, order])
}

// ─── Auth (NextAuth v5 / @auth/prisma-adapter) ──────────────────────────
// Canonical Account / Session / VerificationToken shapes from Auth.js docs.
// User extends the canonical model with role + timestamps.

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
