# Local development. Copy to `.env` (gitignored).
# Matches the postgres service in docker-compose.yml (port 5433 to avoid host conflicts).
DATABASE_URL="postgresql://dodomiles:dodomiles@localhost:5433/dodomiles?schema=public"

# NextAuth (Auth.js v5)
# Generate locally: `openssl rand -base64 32`
AUTH_SECRET=""
# Required on Railway/any platform where the hostname differs from the request Host header.
AUTH_TRUST_HOST=true
# Canonical public origin. Needed in production behind a proxy (e.g. Railway):
# without it Auth.js derives the base URL from the internal container host
# (localhost:8080) and sends a bad redirect_uri to Google. Leave unset locally.
# AUTH_URL="https://dodomiles-production.up.railway.app"

# Google OAuth — register an OAuth app at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include: <site-url>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
